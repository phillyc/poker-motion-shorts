        "fromDeg": 0,
        "toDeg": 81.7,
        "frames": 24,
        "easing": "easeOut",
        "strokePx": 6,
        "color": "chip"
      },
      "odometerRoll": {
        "frames": 22,
        "color": "chip"
      },
      "shake": {
        "amplitudePx": 10,
        "frameStep": 2,
        "frames": 3,
        "maxPerVideo": 1
      },
      "whiteFlash": {
        "frames": 2,
        "color": "ivory",
        "opacity": 0.12,
        "maxPerVideo": 1
      }
    },
    "hardRule": "Audio-off comprehension. Every spoken figure has a matching type card at the same frame. There is no separate subtitle track; the kinetic type is the caption."
